---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Page Not Found (404) — FileBrik Tools"
  description="The requested page or utility route could not be found on FileBrik."
  noindex={true}
>
  <main class="legal-wrap">
    <div class="fb-container fb-container-narrow">
      <article class="fb-card legal-card text-center">
        <h1>404 — Page Not Found</h1>
        <p>The page you requested does not exist on FileBrik.</p>
        <div class="missing-links">
          <a href="/" class="fb-btn fb-btn-primary">All Client-Side Tools</a>
          <a href="/tools/compress-pdf/" class="fb-btn fb-btn-secondary">Compress PDF</a>
          <a href="/tools/exam-photo-signature-resizer/" class="fb-btn fb-btn-secondary">Exam Resizer</a>
        </div>
      </article>
    </div>
  </main>
</Layout>

<style>
  .legal-wrap { padding: 4rem 0; }
  .legal-card { padding: 3rem; }
  .missing-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1.5rem; }
</style>
