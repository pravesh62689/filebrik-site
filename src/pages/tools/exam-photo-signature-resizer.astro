---
// src/pages/tools/exam-photo-signature-resizer.astro
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import examPresets from '../../data/examPresets.json';

const presets = Array.isArray(examPresets) ? examPresets : (examPresets as any).presets;
---
<Layout
  title="Exam Photo & Signature Resizer - UPSC, SSC, IBPS, NEET Portals"
  description="Auto-resize candidate photos and signatures to exact dimensions, KB size limits, and 200/300 DPI for government exam online applications."
  toolSlug="exam-photo-signature-resizer"
>
  <main class="tool-page-wrap">
    <div class="fb-container">
      <div class="tool-grid-layout">
        <div class="tool-main-pane">
          <div class="exam-badge">Examination Portal Photo & Signature Specifications</div>
          <h1 class="tool-header-title">Exam Photo & Signature Resizer</h1>
          <p class="tool-header-sub">Auto-scale, compress within exact KB boundaries, and inject 200/300 DPI JFIF metadata inside your browser memory.</p>

          <div class="preset-selector-card">
            <label for="examSelect" class="preset-label">Select Examination Preset</label>
            <select id="examSelect" class="fb-select preset-dropdown">
              {presets.map((p: any) => (
                <option value={p.id}>
                  {p.name} ({p.type}) — {p.minKB}–{p.maxKB} KB, {p.minWidth}×{p.minHeight}px
                </option>
              ))}
            </select>

            <div id="specCard" class="spec-card">
              <div class="spec-col">
                <span class="spec-title">📐 Dimensions & Size Rule</span>
                <div>File Type: <b id="specType">{presets[0]?.type} ({presets[0]?.format || 'image/jpeg'})</b></div>
                <div>Pixel Size: <b id="specDim">{presets[0]?.minWidth}×{presets[0]?.minHeight} px</b></div>
                <div>File Size: <b id="specKb">{presets[0]?.minKB} – {presets[0]?.maxKB} KB</b></div>
                <div>Resolution: <b id="specDpi">{presets[0]?.dpi} DPI</b></div>
                <div id="specDimNote" class="spec-dim-note">{presets[0]?.dimensionNote || ''}</div>
              </div>
              <div class="spec-col">
                <span class="spec-title">📜 Official Notice Verification</span>
                <div id="verifyBadge" class={`verify-status ${presets[0]?.verificationStatus === 'verified' ? 'verify-ok' : 'verify-warn'}`}>
                  {presets[0]?.verificationStatus === 'verified' ? '✓ Official PDF Verified' : '⚠ Check Official Notice'}
                </div>
                <div class="quote-box" id="specQuote">"{presets[0]?.officialQuote}"</div>
                <div class="source-meta">
                  PDF Source: <a id="specPdfUrl" href={presets[0]?.pdfUrl || presets[0]?.officialUrl} target="_blank" rel="noopener">{presets[0]?.pdfUrl || presets[0]?.officialUrl}</a>
                  (Page <span id="specPdfPage">{presets[0]?.pdfPage || 1}</span>, <span id="specPdfDate">{presets[0]?.pdfDate || presets[0]?.verifiedDate}</span>)
                </div>
                <div class="source-meta">
                  Portal: <a id="specUrl" href={presets[0]?.officialUrl} target="_blank" rel="noopener">{presets[0]?.officialUrl}</a> (<span id="specDate">{presets[0]?.verifiedDate}</span>)
                </div>
              </div>
            </div>
          </div>

          <div class="fb-dropzone" id="fileDropzone">
            <span class="upload-icon">📷</span>
            <h4 id="dropTitle">Upload Image (Photo / Signature / Thumb)</h4>
            <p id="fileStatus" class="file-status">No file selected (JPG, PNG, or WebP)</p>
            <input type="file" id="fileInput" accept="image/*" style="display:none;" />
          </div>

          <button id="processBtn" class="fb-btn fb-btn-primary" style="width:100%; padding:1rem; font-size:1.1rem; margin-top:1.5rem;" disabled>
            Auto-Resize & Inject DPI
          </button>

          <div id="outputSection" class="output-card" style="display:none; margin-top:2rem;">
            <h3>✓ Ready for Portal Upload</h3>
            <div class="preview-item">
              <img id="outputPreview" alt="Resized candidate file" />
              <span id="outputMeta" class="preview-meta"></span>
              <a id="downloadOutput" class="fb-btn fb-btn-success" download="portal-ready.jpg">Download Formatted JPG</a>
            </div>
          </div>
        </div>

        <aside class="tool-sidebar">
          <AdSlot slotType="sidebar" reservedHeight="400px" />
          <div class="tips-box">
            <h4>💡 Submission Reminders</h4>
            <ul>
              <li>Always verify the latest exam notification PDF linked on the official portal.</li>
              <li>Use plain white background for photos; black/blue ink on white paper for signatures.</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <script>
    import examPresetsData from '../../data/examPresets.json';
    import { injectJfifDpi, padJpegToMinBytes } from '../../lib/dpiInject';

    const presets = Array.isArray(examPresetsData) ? examPresetsData : (examPresetsData as any).presets;
    const select = document.getElementById('examSelect') as HTMLSelectElement;
    let currentPreset = presets[0];

    function updateSpecs() {
      const id = select.value;
      currentPreset = presets.find((p: any) => p.id === id) || presets[0];
      document.getElementById('specType')!.textContent = `${currentPreset.type} (${currentPreset.format || 'image/jpeg'})`;
      const dimText = currentPreset.minWidth === currentPreset.maxWidth && currentPreset.minHeight === currentPreset.maxHeight
        ? `${currentPreset.minWidth}×${currentPreset.minHeight} px`
        : `${currentPreset.minWidth}×${currentPreset.minHeight} to ${currentPreset.maxWidth}×${currentPreset.maxHeight} px`;
      document.getElementById('specDim')!.textContent = dimText;
      document.getElementById('specKb')!.textContent = `${currentPreset.minKB} – ${currentPreset.maxKB} KB`;
      document.getElementById('specDpi')!.textContent = `${currentPreset.dpi} DPI`;
      document.getElementById('specDimNote')!.textContent = currentPreset.dimensionNote || '';
      document.getElementById('specQuote')!.textContent = `"${currentPreset.officialQuote}"`;

      const pdfLink = document.getElementById('specPdfUrl') as HTMLAnchorElement;
      pdfLink.href = currentPreset.pdfUrl || currentPreset.officialUrl;
      pdfLink.textContent = currentPreset.pdfUrl || currentPreset.officialUrl;
      document.getElementById('specPdfPage')!.textContent = String(currentPreset.pdfPage || 1);
      document.getElementById('specPdfDate')!.textContent = currentPreset.pdfDate || currentPreset.verifiedDate;

      const link = document.getElementById('specUrl') as HTMLAnchorElement;
      link.href = currentPreset.officialUrl;
      link.textContent = currentPreset.officialUrl;
      document.getElementById('specDate')!.textContent = currentPreset.verifiedDate;

      const badge = document.getElementById('verifyBadge')!;
      if (currentPreset.verificationStatus === 'verified') {
        badge.textContent = `✓ Official PDF Verified (${currentPreset.pdfExtract || 'PDF'}, p.${currentPreset.pdfPage || 1})`;
        badge.className = 'verify-status verify-ok';
      } else {
        badge.textContent = `⚠ Check Official Notice${currentPreset.verifiedNote ? ' — ' + currentPreset.verifiedNote.replace(/^⚠\s*check official notice\s*[—-]\s*/i, '') : ''}`;
        badge.className = 'verify-status verify-warn';
      }
    }

    select.addEventListener('change', updateSpecs);

    const params = new URLSearchParams(window.location.search);
    const urlPreset = params.get('preset');
    if (urlPreset && presets.some((p: any) => p.id === urlPreset)) {
      select.value = urlPreset;
    }
    updateSpecs();

    const drop = document.getElementById('fileDropzone')!;
    const input = document.getElementById('fileInput') as HTMLInputElement;
    const status = document.getElementById('fileStatus')!;
    const processBtn = document.getElementById('processBtn') as HTMLButtonElement;
    let chosenFile: File | null = null;

    drop.addEventListener('click', () => input.click());
    input.addEventListener('change', () => {
      if (input.files?.[0]) {
        chosenFile = input.files[0];
        status.textContent = `${chosenFile.name} (${(chosenFile.size / 1024).toFixed(1)} KB)`;
        processBtn.disabled = false;
      }
    });

    function canvasToJpeg(canvas: HTMLCanvasElement, q: number): Promise<Blob> {
      return new Promise((resolve) => canvas.toBlob((b) => resolve(b!), 'image/jpeg', q));
    }

    processBtn.addEventListener('click', async () => {
      if (!chosenFile) return;
      processBtn.disabled = true;
      processBtn.textContent = 'Formatting & injecting DPI...';
      const dlBtn = document.getElementById('downloadOutput') as HTMLAnchorElement;
      dlBtn.removeAttribute('data-preset');

      try {
        const img = new Image();
        const url = URL.createObjectURL(chosenFile);
        img.src = url;
        await new Promise((res, rej) => { img.onload = res; img.onerror = rej; });
        URL.revokeObjectURL(url);

        const midW = Math.round((currentPreset.minWidth + currentPreset.maxWidth) / 2);
        const midH = Math.round((currentPreset.minHeight + currentPreset.maxHeight) / 2);
        const renderAttempts = [
          { w: midW, h: midH, filter: 'none' },
          { w: currentPreset.maxWidth, h: currentPreset.maxHeight, filter: 'none' },
          { w: currentPreset.minWidth, h: currentPreset.minHeight, filter: 'none' },
          { w: currentPreset.minWidth, h: currentPreset.minHeight, filter: 'blur(1px)' },
          { w: currentPreset.minWidth, h: currentPreset.minHeight, filter: 'blur(2.5px)' },
        ];

        let targetW = midW;
        let targetH = midH;
        let bestBlob: Blob | null = null;

        for (const attempt of renderAttempts) {
          targetW = attempt.w;
          targetH = attempt.h;
          const canvas = document.createElement('canvas');
          canvas.width = targetW;
          canvas.height = targetH;
          const ctx = canvas.getContext('2d')!;
          ctx.fillStyle = '#FFFFFF';
          ctx.fillRect(0, 0, targetW, targetH);
          ctx.filter = attempt.filter;
          ctx.drawImage(img, 0, 0, targetW, targetH);
          ctx.filter = 'none';

          let low = 0.01, high = 0.99;
          let candidate = await canvasToJpeg(canvas, 0.75);
          for (let i = 0; i < 12; i++) {
            const q = (low + high) / 2;
            const b = await canvasToJpeg(canvas, q);
            const kb = b.size / 1024;
            if (kb >= currentPreset.minKB && kb <= currentPreset.maxKB) {
              candidate = b;
              break;
            }
            if (kb > currentPreset.maxKB) {
              high = q;
              candidate = b;
            } else {
              low = q;
              candidate = b;
            }
          }
          bestBlob = candidate;
          const kbNow = bestBlob.size / 1024;
          if (kbNow >= currentPreset.minKB && kbNow <= currentPreset.maxKB) break;
          // If on max dimensions and still <= maxKB (just below minKB), byte-padding below will bring it cleanly inside [minKB, maxKB]
          if (kbNow < currentPreset.minKB && targetW === currentPreset.maxWidth && targetH === currentPreset.maxHeight) break;
        }

        let buf = injectJfifDpi(await bestBlob!.arrayBuffer(), currentPreset.dpi || 200);
        const minBytes = Math.ceil(currentPreset.minKB * 1024);
        const maxBytes = Math.floor(currentPreset.maxKB * 1024);
        const targetMinBytes = Math.min(maxBytes, Math.ceil((currentPreset.minKB + Math.min(1, (currentPreset.maxKB - currentPreset.minKB) * 0.25)) * 1024));
        if (buf.byteLength < minBytes) {
          buf = padJpegToMinBytes(buf, targetMinBytes);
        }

        const finalBlob = new Blob([buf], { type: 'image/jpeg' });
        const outUrl = URL.createObjectURL(finalBlob);

        (document.getElementById('outputPreview') as HTMLImageElement).src = outUrl;
        document.getElementById('outputMeta')!.textContent = `${(finalBlob.size / 1024).toFixed(1)} KB • ${targetW}×${targetH} px • ${currentPreset.dpi} DPI`;
        const dl = document.getElementById('downloadOutput') as HTMLAnchorElement;
        dl.href = outUrl;
        dl.download = `${currentPreset.id}.jpg`;
        dl.setAttribute('data-preset', currentPreset.id);
        document.getElementById('outputSection')!.style.display = 'block';
      } finally {
        processBtn.textContent = 'Auto-Resize & Inject DPI';
        processBtn.disabled = false;
      }
    });
  </script>
</Layout>

<style>
  .tool-page-wrap { padding: 3rem 0; }
  .tool-grid-layout { display: grid; grid-template-columns: 1fr 300px; gap: 2.5rem; }
  .exam-badge { display: inline-block; background: #EEF2FF; color: var(--fb-primary); font-size: 0.8rem; font-weight: 700; padding: 0.35rem 0.75rem; border-radius: var(--fb-radius-md); margin-bottom: 1rem; }
  .tool-header-title { font-size: 2.25rem; font-weight: 900; margin-bottom: 0.5rem; }
  .tool-header-sub { font-size: 1rem; color: var(--fb-text-muted); margin-bottom: 2rem; }
  .preset-selector-card { background: var(--fb-surface); border: 1px solid var(--fb-border); border-radius: var(--fb-radius-lg); padding: 1.5rem; margin-bottom: 2rem; }
  .preset-label { display: block; font-size: 0.85rem; font-weight: 700; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--fb-text-muted); }
  .preset-dropdown { width: 100%; border: 1px solid var(--fb-primary); font-weight: 700; }
  .spec-card { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1.25rem; background: var(--fb-surface-alt); padding: 1rem; border-radius: var(--fb-radius-md); }
  .spec-title { font-size: 0.85rem; font-weight: 800; display: block; margin-bottom: 0.35rem; color: var(--fb-text-main); }
  .spec-col div { font-size: 0.8rem; color: var(--fb-text-muted); margin-bottom: 0.25rem; }
  .spec-col b { color: var(--fb-text-main); }
  .verify-status { font-weight: 700; padding: 0.25rem 0.5rem; border-radius: 6px; display: inline-block; margin-bottom: 0.4rem; }
  .verify-ok { background: #ECFDF5; color: #047857; }
  .verify-warn { background: #FEF3C7; color: #92400E; }
  .quote-box { font-style: italic; font-size: 0.78rem; color: var(--fb-text-main); margin-bottom: 0.35rem; }
  .spec-dim-note { font-size: 0.75rem; color: var(--fb-text-muted); margin-top: 0.25rem; }
  .source-meta { font-size: 0.72rem; word-break: break-all; margin-top: 0.2rem; }
  .fb-dropzone { border: 2px dashed var(--fb-border); border-radius: var(--fb-radius-lg); padding: 2.5rem 1rem; text-align: center; cursor: pointer; background: var(--fb-surface); }
  .upload-icon { font-size: 2.5rem; margin-bottom: 0.5rem; display: block; }
  .file-status { margin-top: 0.75rem; font-size: 0.85rem; font-weight: 600; color: var(--fb-primary); }
  .output-card { background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: var(--fb-radius-lg); padding: 1.5rem; }
  .preview-item { background: white; padding: 1rem; border-radius: var(--fb-radius-md); text-align: center; border: 1px solid var(--fb-border); margin-top: 1rem; }
  .preview-item img { max-width: 100%; max-height: 180px; border-radius: 4px; margin-bottom: 0.5rem; }
  .preview-meta { display: block; font-size: 0.8rem; color: var(--fb-text-muted); margin-bottom: 0.75rem; font-weight: 600; }
  .tips-box { background: var(--fb-surface); border: 1px solid var(--fb-border); border-radius: var(--fb-radius-lg); padding: 1.25rem; font-size: 0.85rem; margin-top: 1.25rem; }
  .tips-box h4 { font-weight: 800; margin-bottom: 0.5rem; }
  .tips-box ul { padding-left: 1.25rem; color: var(--fb-text-muted); }
  @media (max-width: 900px) {
    .tool-grid-layout { grid-template-columns: 1fr; }
    .spec-card { grid-template-columns: 1fr; }
  }
</style>
