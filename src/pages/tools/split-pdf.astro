---
// src/pages/tools/split-pdf.astro
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
---
<Layout
  title="Split PDF Pages Client-Side"
  description="Extract individual pages or custom page ranges into standalone PDF documents."
  toolSlug="split-pdf"
>
  <main class="tool-page-wrap">
    <div class="fb-container">
      <div class="tool-grid-layout">
        <div class="tool-main-pane">
          <div class="privacy-pill">🛡️ 100% Client-Side Memory • Zero Cloud Storage</div>
          <h1 class="tool-header-title">Split PDF Pages</h1>
          <p class="tool-header-sub">Extract specific pages (e.g. 1-3, 5) into a clean standalone PDF directly in browser memory.</p>

          <div class="fb-dropzone" id="dropzone">
            <div class="drop-icon">✂️</div>
            <h3>Drop your PDF file here</h3>
            <p>or click to select from your device</p>
            <input type="file" id="fileInput" accept="application/pdf" style="display:none;" />
          </div>

          <div class="settings-box">
            <div class="form-row">
              <label for="pageRange">Page Range (1-indexed, e.g. 1-2 or 1,3)</label>
              <input type="text" id="pageRange" class="fb-input" value="1" placeholder="1-2" />
            </div>
            <button id="actionBtn" class="fb-btn fb-btn-primary" disabled>Split PDF</button>
          </div>

          <div id="resultBox" class="result-box" style="display:none;">
            <h4>✓ Pages Extracted</h4>
            <p id="resultText"></p>
            <a id="downloadBtn" class="fb-btn fb-btn-success" href="#" download="split.pdf">Download Split PDF</a>
          </div>
        </div>

        <aside class="tool-sidebar">
          <AdSlot slotType="sidebar" reservedHeight="450px" />
        </aside>
      </div>
    </div>
  </main>

  <script>
    import { PDFDocument } from 'pdf-lib';

    const dropzone = document.getElementById('dropzone')!;
    const input = document.getElementById('fileInput') as HTMLInputElement;
    const rangeInput = document.getElementById('pageRange') as HTMLInputElement;
    const btn = document.getElementById('actionBtn') as HTMLButtonElement;
    const resultBox = document.getElementById('resultBox')!;
    const resultText = document.getElementById('resultText')!;
    const downloadBtn = document.getElementById('downloadBtn') as HTMLAnchorElement;
    let loaded: File | null = null;

    dropzone.addEventListener('click', () => input.click());
    input.addEventListener('change', () => {
      if (input.files?.[0]) {
        loaded = input.files[0];
        dropzone.querySelector('h3')!.textContent = loaded.name;
        dropzone.querySelector('p')!.textContent = (loaded.size / 1024).toFixed(1) + ' KB';
        btn.disabled = false;
      }
    });

    function parseIndices(spec: string, total: number): number[] {
      const set = new Set<number>();
      for (const part of spec.split(',')) {
        const p = part.trim();
        if (p.includes('-')) {
          const [a, b] = p.split('-').map(n => parseInt(n.trim(), 10));
          for (let i = Math.max(1, a || 1); i <= Math.min(total, b || total); i++) set.add(i - 1);
        } else {
          const idx = parseInt(p, 10);
          if (idx >= 1 && idx <= total) set.add(idx - 1);
        }
      }
      return set.size ? [...set] : [0];
    }

    btn.addEventListener('click', async () => {
      if (!loaded) return;
      btn.disabled = true;
      btn.textContent = 'Splitting in memory...';
      try {
        const src = await PDFDocument.load(await loaded.arrayBuffer());
        const out = await PDFDocument.create();
        const indices = parseIndices(rangeInput.value || '1', src.getPageCount());
        const pages = await out.copyPages(src, indices);
        pages.forEach(p => out.addPage(p));
        const blob = new Blob([await out.save()], { type: 'application/pdf' });
        downloadBtn.href = URL.createObjectURL(blob);
        downloadBtn.download = loaded.name.replace(/\.pdf$/i, '') + '-split.pdf';
        resultText.textContent = `Extracted ${indices.length} page(s) (${(blob.size / 1024).toFixed(1)} KB).`;
        resultBox.style.display = 'block';
      } finally {
        btn.textContent = 'Split PDF';
        btn.disabled = false;
      }
    });
  </script>
</Layout>

<style>
  .tool-page-wrap { padding: 3rem 0; }
  .tool-grid-layout { display: grid; grid-template-columns: 1fr 300px; gap: 2.5rem; }
  .privacy-pill { display: inline-block; background: #ECFDF5; color: #047857; font-size: 0.8rem; font-weight: 700; padding: 0.35rem 0.75rem; border-radius: var(--fb-radius-md); margin-bottom: 1rem; }
  .tool-header-title { font-size: 2.25rem; font-weight: 900; margin-bottom: 0.5rem; }
  .tool-header-sub { font-size: 1rem; color: var(--fb-text-muted); margin-bottom: 2rem; }
  .fb-dropzone { border: 2px dashed var(--fb-border); border-radius: var(--fb-radius-lg); padding: 3.5rem 2rem; text-align: center; cursor: pointer; background: var(--fb-surface); margin-bottom: 2rem; }
  .drop-icon { font-size: 3rem; margin-bottom: 1rem; }
  .settings-box { background: var(--fb-surface); border: 1px solid var(--fb-border); border-radius: var(--fb-radius-lg); padding: 1.5rem; margin-bottom: 2rem; }
  .form-row { margin-bottom: 1.25rem; }
  .form-row label { display: block; font-size: 0.85rem; font-weight: 700; margin-bottom: 0.5rem; }
  .result-box { background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: var(--fb-radius-lg); padding: 1.5rem; margin-bottom: 2rem; }
  @media (max-width: 900px) { .tool-grid-layout { grid-template-columns: 1fr; } }
</style>
