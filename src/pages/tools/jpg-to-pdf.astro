---
// src/pages/tools/jpg-to-pdf.astro
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import AdSlot from '../../components/AdSlot.astro';
import ToolArticle from '../../components/ToolArticle.astro';
import { TOOL_GUIDES, buildToolJsonLd } from '../../data/toolGuides';

const title = 'JPG to PDF Converter Client-Side';
const description = 'Convert multiple JPG, PNG, and WebP images into a single clean printable PDF file.';
const guide = TOOL_GUIDES['jpg-to-pdf'];
const ld = buildToolJsonLd('jpg-to-pdf', title, description);
---
<Layout
  title={title}
  description={description}
  toolSlug="jpg-to-pdf"
  jsonLd={ld}
>
  <main class="tool-page-wrap">
    <div class="fb-container">
      <div class="tool-grid-layout">
        <div class="tool-main-pane">
          <div class="privacy-pill"><Icon name="shield" size={14} /> On-Device Browser Memory • No Cloud Storage</div>
          <h1 class="tool-header-title">JPG to PDF Converter</h1>
          <p class="tool-header-sub">Merge your photos, scanned ID proofs, and certificates into a consolidated PDF in browser memory.</p>

          <div class="fb-dropzone" id="dropzone">
            <div class="drop-icon"><Icon name="image" size={32} /></div>
            <h3>Drop JPG or PNG files here</h3>
            <p>or click to select multiple images from your device</p>
            <input type="file" id="fileInput" accept="image/*" multiple style="display:none;" />
          </div>

          <div class="settings-box">
            <button id="actionBtn" class="fb-btn fb-btn-primary" disabled>Convert to PDF</button>
          </div>

          <div id="resultBox" class="result-box" style="display:none;">
            <h4><Icon name="check" size={16} /> PDF Created</h4>
            <p id="resultText"></p>
            <a id="downloadBtn" class="fb-btn fb-btn-success" href="#" download="images.pdf">Download PDF</a>
          </div>

          <AdSlot slotType="in-result" reservedHeight="250px" />
      <ToolArticle {...guide} />
        </div>

        <aside class="tool-sidebar">
          <AdSlot slotType="sidebar" reservedHeight="450px" />
        </aside>
      </div>
    </div>
  </main>

  <script>
    import { PDFDocument } from 'pdf-lib';

    const dropzone = document.getElementById('dropzone')!;
    const input = document.getElementById('fileInput') as HTMLInputElement;
    const btn = document.getElementById('actionBtn') as HTMLButtonElement;
    const resultBox = document.getElementById('resultBox')!;
    const resultText = document.getElementById('resultText')!;
    const downloadBtn = document.getElementById('downloadBtn') as HTMLAnchorElement;
    let files: File[] = [];

    dropzone.addEventListener('click', () => input.click());
    input.addEventListener('change', () => {
      if (input.files?.length) {
        files = Array.from(input.files);
        dropzone.querySelector('h3')!.textContent = `${files.length} image(s) selected`;
        btn.disabled = false;
      }
    });

    btn.addEventListener('click', async () => {
      if (!files.length) return;
      btn.disabled = true;
      btn.textContent = 'Building PDF...';

      try {
        const pdfDoc = await PDFDocument.create();
        for (const f of files) {
          const img = new Image();
          const url = URL.createObjectURL(f);
          img.src = url;
          await new Promise((res, rej) => { img.onload = res; img.onerror = rej; });
          URL.revokeObjectURL(url);

          const canvas = document.createElement('canvas');
          canvas.width = img.naturalWidth;
          canvas.height = img.naturalHeight;
          const ctx = canvas.getContext('2d')!;
          ctx.fillStyle = '#FFFFFF';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(img, 0, 0);

          const jpgBlob = await new Promise<Blob>((r) => canvas.toBlob((b) => r(b!), 'image/jpeg', 0.9));
          const embedded = await pdfDoc.embedJpg(await jpgBlob.arrayBuffer());
          const page = pdfDoc.addPage([embedded.width, embedded.height]);
          page.drawImage(embedded, { x: 0, y: 0, width: embedded.width, height: embedded.height });
        }

        const pdfBytes = await pdfDoc.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        downloadBtn.href = URL.createObjectURL(blob);
        resultText.textContent = `Built ${files.length}-page PDF (${(blob.size / 1024).toFixed(1)} KB).`;
        resultBox.style.display = 'block';
      } finally {
        btn.textContent = 'Convert to PDF';
        btn.disabled = false;
      }
    });
  </script>
</Layout>

<style>
  .tool-page-wrap { padding: 3rem 0; }
  .tool-grid-layout { display: grid; grid-template-columns: 1fr 300px; gap: 2.5rem; }
  .privacy-pill { display: inline-block; background: #ECFDF5; color: #047857; font-size: 0.8rem; font-weight: 700; padding: 0.35rem 0.75rem; border-radius: var(--fb-radius-md); margin-bottom: 1rem; }
  .tool-header-title { font-size: 2.25rem; font-weight: 900; margin-bottom: 0.5rem; }
  .tool-header-sub { font-size: 1rem; color: var(--fb-text-muted); margin-bottom: 2rem; }
  .fb-dropzone { border: 2px dashed var(--fb-border); border-radius: var(--fb-radius-lg); padding: 3.5rem 2rem; text-align: center; cursor: pointer; background: var(--fb-surface); margin-bottom: 2rem; }
  .drop-icon { font-size: 3rem; margin-bottom: 1rem; }
  .settings-box { background: var(--fb-surface); border: 1px solid var(--fb-border); border-radius: var(--fb-radius-lg); padding: 1.5rem; margin-bottom: 2rem; }
  .result-box { background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: var(--fb-radius-lg); padding: 1.5rem; margin-bottom: 2rem; }
  @media (max-width: 900px) { .tool-grid-layout { grid-template-columns: 1fr; } }
</style>
