---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="100% Private, Client-Side PDF & Media Tools"
  description="Free, secure, client-side PDF compression, merging, image resizing to KB, exam photo adjustments, and audio trimming with zero cloud uploads."
>
  <main>
    <section class="hero-section">
      <div class="fb-container text-center">
        <div class="privacy-badge">🔒 100% Client-Side Privacy — Files Never Leave Your Device</div>
        <h1 class="hero-title">Ultra-Fast PDF & Media Utilities,<br><span class="highlight">Zero Server Uploads</span></h1>
        <p class="hero-subtitle">Compress PDFs, merge documents, resize exam photos to exact KB and DPI, and convert images directly inside your browser memory. Instant, private, and offline-ready.</p>
      </div>
    </section>

    <section class="tools-section">
      <div class="fb-container">
        <div class="tools-grid">
          <a href="/tools/compress-pdf" class="fb-card tool-item">
            <div class="tool-icon">🗜️</div>
            <h3>Compress PDF</h3>
            <p>Reduce PDF file size to target KBs (100KB, 200KB, 500KB) while preserving high document readability.</p>
          </a>
          <a href="/tools/merge-pdf" class="fb-card tool-item">
            <div class="tool-icon">📑</div>
            <h3>Merge PDF</h3>
            <p>Combine multiple PDF files into one clean document with visual drag-and-drop reordering.</p>
          </a>
          <a href="/tools/split-pdf" class="fb-card tool-item">
            <div class="tool-icon">✂️</div>
            <h3>Split PDF</h3>
            <p>Extract specific pages or page ranges into standalone lightweight PDF files instantly.</p>
          </a>
          <a href="/tools/jpg-to-pdf" class="fb-card tool-item">
            <div class="tool-icon">🖼️</div>
            <h3>JPG to PDF</h3>
            <p>Convert photos, passport copies, and receipts into a structured multi-page PDF.</p>
          </a>
          <a href="/tools/pdf-to-jpg" class="fb-card tool-item">
            <div class="tool-icon">📸</div>
            <h3>PDF to JPG</h3>
            <p>Render PDF pages into crisp high-resolution WebP or JPEG images in your browser.</p>
          </a>
          <a href="/tools/exam-photo-signature-resizer" class="fb-card tool-item featured-tool">
            <div class="featured-badge">Govt Portals</div>
            <div class="tool-icon">🎓</div>
            <h3>Exam Photo & Signature</h3>
            <p>Auto-scale to exact dimension, KB limit, and 200/300 DPI for UPSC, SSC, IBPS, NEET, and PAN.</p>
          </a>
          <a href="/tools/compress-image-kb" class="fb-card tool-item">
            <div class="tool-icon">📉</div>
            <h3>Compress Image to KB</h3>
            <p>Binary-search quality optimization to hit strict portal thresholds (under 20KB, 50KB, 100KB).</p>
          </a>
          <a href="/tools/image-converter" class="fb-card tool-item">
            <div class="tool-icon">🔄</div>
            <h3>Image Converter</h3>
            <p>Convert seamlessly between WebP, PNG, JPEG, and AVIF formats without server re-encoding.</p>
          </a>
          <a href="/tools/passport-photo-maker" class="fb-card tool-item">
            <div class="tool-icon">🛂</div>
            <h3>Passport Photo Maker</h3>
            <p>Generate printable 2x2 inch and 35x45mm passport photo sheets with standard cut lines.</p>
          </a>
          <a href="/tools/audio-trimmer" class="fb-card tool-item">
            <div class="tool-icon">🎵</div>
            <h3>Audio Trimmer</h3>
            <p>Cut and trim voice memos, podcasts, and ringtones client-side with millisecond waveform precision.</p>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero-section {
    padding: 4rem 0 2rem;
  }
  .privacy-badge {
    display: inline-flex;
    align-items: center;
    background: var(--fb-primary-light);
    color: var(--fb-primary);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: var(--fb-radius-full);
    margin-bottom: 1.5rem;
  }
  .hero-title {
    font-size: 2.75rem;
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--fb-text-main);
  }
  .highlight {
    color: var(--fb-primary);
  }
  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--fb-text-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .tools-section {
    padding: 3rem 0;
  }
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1.5rem;
  }
  .tool-item {
    text-decoration: none;
    color: inherit;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .tool-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
    width: 48px;
    height: 48px;
    background: var(--fb-primary-light);
    border-radius: var(--fb-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tool-item h3 {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }
  .tool-item p {
    font-size: 0.85rem;
    color: var(--fb-text-muted);
    line-height: 1.5;
    flex-grow: 1;
  }
  .featured-tool {
    border-color: var(--fb-primary);
    background: linear-gradient(to bottom, #FFFFFF, #FAF5FF);
  }
  .featured-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--fb-primary);
    color: white;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: var(--fb-radius-full);
    text-transform: uppercase;
  }
  @media (max-width: 640px) {
    .hero-title {
      font-size: 2rem;
    }
    .hero-subtitle {
      font-size: 1rem;
    }
  }
</style>
