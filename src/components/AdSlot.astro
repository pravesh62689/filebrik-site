---
// src/components/AdSlot.astro
interface Props {
  slotType: 'sidebar' | 'banner' | 'in-feed';
  reservedHeight?: string;
}

const { slotType, reservedHeight = '280px' } = Astro.props;
const adsEnabled = import.meta.env.PUBLIC_ADS_ENABLED === 'true';
---
{adsEnabled ? (
  <div class={`ad-container ad-slot-${slotType}`} data-ad-slot={slotType} style={`min-height: ${reservedHeight};`}>
    <div class="ad-label">Advertisement</div>
    <div class="ad-content-slot" id={`ad-slot-${slotType}`}></div>
  </div>
) : (
  <div class="ad-slot-disabled" data-ad-slot={slotType} data-ads-enabled="false" aria-hidden="true"></div>
)}

<style>
  .ad-slot-disabled {
    display: none;
    height: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
  }
  .ad-container {
    width: 100%;
    background: var(--fb-surface);
    border: 1px dashed var(--fb-border);
    border-radius: var(--fb-radius-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    margin: 1.5rem 0;
  }
  .ad-label {
    position: absolute;
    top: 6px;
    right: 8px;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fb-text-light);
  }
  .ad-slot-sidebar {
    max-width: 300px;
    margin: 0 auto;
  }
  .ad-slot-banner {
    max-width: 728px;
    margin: 2rem auto;
  }
  @media (max-width: 900px) {
    .ad-container {
      min-height: 90px !important;
      max-height: 120px !important;
      margin: 0.75rem auto;
    }
  }
</style>
