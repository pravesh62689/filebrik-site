---
// src/components/Footer.astro
---
<footer class="fb-footer">
  <div class="fb-container footer-inner">
    <div class="footer-brand">
      <div class="footer-logo">⚡ FileBrik</div>
      <p class="footer-tagline">100% Client-Side PDF, Image & Audio Utilities. Your sensitive files never leave your device.</p>
      <div class="footer-badge">🛡️ Zero Cloud Uploads • Client-Side WASM & Canvas</div>
    </div>
    <div class="footer-links-grid">
      <div class="link-col">
        <p class="link-col-title">Popular PDF Tools</p>
        <a href="/tools/compress-pdf">Compress PDF</a>
        <a href="/tools/merge-pdf">Merge PDF</a>
        <a href="/tools/split-pdf">Split PDF</a>
        <a href="/tools/jpg-to-pdf">JPG to PDF</a>
        <a href="/tools/pdf-to-jpg">PDF to JPG</a>
      </div>
      <div class="link-col">
        <p class="link-col-title">Image & Media Tools</p>
        <a href="/tools/exam-photo-signature-resizer">Exam Resizer</a>
        <a href="/tools/compress-image-kb">Compress Image to KB</a>
        <a href="/tools/image-converter">Image Converter</a>
        <a href="/tools/passport-photo-maker">Passport Photo Maker</a>
        <a href="/tools/audio-trimmer">Audio Trimmer</a>
      </div>
      <div class="link-col">
        <p class="link-col-title">Trust & Legal</p>
        <a href="/privacy">Privacy Architecture</a>
        <a href="/terms">Terms of Service</a>
        <a href="/contact">Support & Contact</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="fb-container bottom-inner">
      <p>© 2026 FileBrik. All file manipulation executes entirely within local browser memory.</p>
    </div>
  </div>
</footer>

<style>
  .fb-footer {
    background: var(--fb-surface);
    border-top: 1px solid var(--fb-border);
    margin-top: 5rem;
    padding-top: 3.5rem;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    padding-bottom: 3rem;
  }
  .footer-logo {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--fb-primary);
    margin-bottom: 0.75rem;
  }
  .footer-tagline {
    font-size: 0.85rem;
    color: var(--fb-text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
    max-width: 320px;
  }
  .footer-badge {
    display: inline-block;
    background: var(--fb-surface-alt);
    border: 1px solid var(--fb-border);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.65rem;
    border-radius: var(--fb-radius-md);
    color: var(--fb-text-muted);
  }
  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .link-col-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fb-text-main);
    margin-bottom: 1rem;
  }
  .link-col a {
    display: block;
    color: var(--fb-text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    margin-bottom: 0.6rem;
    transition: color 0.15s;
  }
  .link-col a:hover {
    color: var(--fb-primary);
  }
  .footer-bottom {
    border-top: 1px solid var(--fb-border);
    padding: 1.25rem 0;
    background: var(--fb-surface-alt);
  }
  .bottom-inner {
    font-size: 0.8rem;
    color: var(--fb-text-muted);
    text-align: center;
  }
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
    .footer-links-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
