---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  toolSlug?: string;
}

const { title, description, toolSlug } = Astro.props;
const siteOrigin = Astro.site?.origin || 'https://filebrik.pages.dev';
const normalizedPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(normalizedPath, siteOrigin);
const adsEnabled = import.meta.env.PUBLIC_ADS_ENABLED === 'true';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | FileBrik</title>
  <meta name="description" content={description}>
  <meta name="google-site-verification" content="EuP7tR_9jMW5UuGvMcL4iTqmbOJUfRJT3FeuZgJbvj0" />
  <link rel="canonical" href={canonicalUrl.href}>
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Open Graph / Meta -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl.href}>
  <meta property="og:title" content={`${title} | FileBrik`}>
  <meta property="og:description" content={description}>
  <meta property="og:site_name" content="FileBrik">

  <script is:inline define:vars={{ adsEnabled }}>
    window.PUBLIC_ADS_ENABLED = adsEnabled;
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>
</head>
<body data-tool-slug={toolSlug || ''}>
  <Header />
  <slot />
  <div id="fb-desktop-slider" aria-hidden="true" hidden></div>
  <Footer />
</body>
</html>
